class Point:
    def __init__(self, x=None, y=None):
        self.x = x
        self.y = y

class PathSegment:
    def __init__(self, fromPoint=None, toPoint=None):
        self.fr = fromPoint
        self.to = toPoint

    def length(self):
        dy = self.fr.y - self.to.y
        dx = self.fr.x - self.to.x
        return math.sqrt( (dy*dy) + (dx*dx) )

