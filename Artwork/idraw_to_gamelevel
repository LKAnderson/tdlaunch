class ProjectileSource:
    def __init__(self, jsonObj):
        self.position = jsonObj["position"]
        self.rotationAngle = jsonObj["rotationAngle"]
        self.rate = jsonObj["rate"]
        self.initialDelay = jsonObj["initialDelay"] if "initialDelay" in jsonObj else 0
        self.initialVelocity = jsonObj["initialVelocity"]
        self.impulseCount = jsonObj["impulseCount"]
        self.impulseTimer = jsonObj["impulseTimer"]
        self.impulse = jsonObj["impulse"]
        self.objectType = jsonObj["objectType"]
        self.maxCurrent = jsonObj["maxCurrent"] if "maxCurrent" in jsonObj else 0
        self.endAnimation = jsonObj["endAnimation"] if "endAnimation" in jsonObj else None
        
        
        
