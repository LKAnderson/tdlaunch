def Spaces():
    print 
    print "Spaces to Plists"
    print
    if not os.path.exists("exported/Levels"):
        os.makedirs("exported/Levels")

    for level in ["Level"+str(n) for n in range(0,11)]:
        if not os.path.exists(level+".json"):
            continue

        srcModTime = max(os.path.getmtime(level+".idraw"), os.path.getmtime(level+".json"))
        dstFile = "exported/Levels/{0}".format(level)
        dstModTime = 0
        if os.path.exists(dstFile+".m"):
            dstModTime = os.path.getmtime(dstFile+".m")

        if srcModTime > dstModTime:
            print "%s.idraw --> %s.m,h" % (level, level)
            subprocess.call("./idraw_to_gamelevel header "+level+".idraw > exported/Levels/"+level+".h", shell=True)
            subprocess.call("./idraw_to_gamelevel code "+level+".idraw > exported/Levels/"+level+".m", shell=True)
            products.append(dstFile+".m")
            products.append(dstFile+".h")
            

