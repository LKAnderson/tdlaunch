def isExported(s):
    if len(exported) == 0:
        return True
    if s in exported:
        return True
    return False


def GetResolutions(w,h):
    return [    ["-ipadhd", w*2, h*2], 
                ["-ipad",   w, h]
            ]


def ExportItem(inputFile, outputFile, itemId, width, height, install=False):

    for suffix, w, h in GetResolutions(width,height):
        product = "%s/%s%s.png" % (outputDirectory, outputFile, suffix)
        if install:
            products.append(product)

        cmd = [inkScape]
        cmd += [inputFile]
        cmd += ["--without-gui"]
        cmd += ["--export-png=" + product]
        cmd += ["--export-id=" + itemId]
        cmd += ["--export-id-only"]
        cmd += ["--export-width=" + str(w)]
        cmd += ["--export-height=" + str(h)]
        print "%s[%s] --> %s : (%dx%d)" % (inputFile, itemId, outputFile, w, h)
        if debug: 
            print cmd
        
        subprocess.call(cmd, stdout=file("/dev/null"), stderr=subprocess.STDOUT)

            



def ExportArea(inputFile, outputFile, width, height, x1, y1, x2, y2, install=False):

    for suffix, w, h in GetResolutions(width,height):
