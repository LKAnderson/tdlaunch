        print "%s[%d:%d:%d:%d] --> %s : %dx%d" % (inputFile, x1,y1,x2,y2, outputFile, w,h)
        if debug:
            print cmd
        subprocess.call(cmd, stdout=file("/dev/null"), stderr=subprocess.STDOUT)



def ExportBackgroundPanels( inputFile, layerName, outputFile, width, height, tileWidth, tileHeight=0):
    if tileHeight == 0:
        tileHeight = tileWidth

    tmpFile = "/tmp/" + inputFile
    SoloLayer(inputFile, tmpFile, layerName)

    y1 = 0
    y2 = y1 + tileHeight 

    while y1 < height:
        x1 = 0
        x2 = x1 + tileWidth
        while x1 < width:
            ExportArea( tmpFile, "%s-%d-%d" % (outputFile, x1, y1), 
                    tileWidth, tileHeight, x1, y1, x2, y2, True )
            x1 = x2
            x2 = x1 + tileWidth
            if x2 > width:
                x2 = width

        y1 = y2
        y2 = y1 + tileHeight
        if y2 > height:
            y2 = height

    DeleteFile(tmpFile)
    
    
def ExportBackgroundPanels2( inputFile, outputFile, imgWidth, imgHeight, tileWidth, tileHeight=0, install=False):
    
    if not os.path.exists(inputFile+"-ipad.png") or not os.path.exists(inputFile+"-ipadhd.png"):
        print "ExportBackgroundPanels2: input file does not exist:", inputFile+"-ipad.png", "or", inputFile+"-ipadhd.png"
        return
    
    if tileHeight == 0:
        tileHeight = tileWidth

    h = 0
    while h < imgHeight:
        w = 0
        while w < imgWidth:
            outputFileName = "%s-%d-%d" % (outputFile, w, h)
            cmd_ipad = "gm convert -crop %dx%d+%d+%d %s %s-ipad.png" % (tileWidth, tileHeight, w, (imgHeight-tileHeight)-h, inputFile+"-ipad.png", outputFileName)
            cmd_ipadhd = "gm convert -crop %dx%d+%d+%d %s %s-ipadhd.png" % (tileWidth*2, tileHeight*2, w*2, ((imgHeight-tileHeight)-h)*2, inputFile+"-ipadhd.png", outputFileName)
            print cmd_ipad
            subprocess.call([cmd_ipad], shell=True)
            print cmd_ipadhd
            subprocess.call([cmd_ipadhd], shell=True)
            if install:
                products.append(outputFileName+"-ipad.png")
                products.append(outputFileName+"-ipadhd.png")
            w += 1024
        h += 1024
    
def CropImage(inputFileTemplate, outputFileTemplate, x1, y1, x2, y2, install=False):
    resolutions = ( ( "-ipad", 1 ),
                    ( "-ipadhd", 2 ) )

    for res in resolutions:
        inputFileName = "{0}{1}.png".format(inputFileTemplate, res[0])
        outputFileName = "{0}{1}.png".format(outputFileTemplate, res[0])
        CropRawImage(inputFileName, outputFileName, x1*res[1], y1*res[1], x2*res[1], y2*res[1])
        if install:
            products.append(outputFileName)

def CropImageAdj(inputFileTemplate, outputFileTemplate, x, y, w, h, install=False):
    CropImage(inputFileTemplate, outputFileTemplate, x-1, y-1, x+w+2, y+h+2, install)

    

def CropRawImage(inputFile, outputFile, x1, y1, x2, y2):
    cmd = "gm convert -crop %dx%d+%d+%d %s %s" % (x2-x1, y2-y1, x1, y1, inputFile, outputFile)
    print cmd
    subprocess.call([cmd], shell=True)

def ScaleImagePct(inputFile, outputFile, pct):
    cmd = "gm convert -scale %f%%x%f%% %s %s" % (pct, pct, inputFile, outputFile)
    print cmd
    subprocess.call([cmd], shell=True)


def SoloLayer(inputFile, outputFile, layerName):
    soloCmd = "./sololayer %s %s > %s" % (inputFile, layerName, outputFile)
    subprocess.call(soloCmd, shell=True)


def DeleteFile(filename):
    subprocess.call("/bin/rm " + filename, shell=True)


def CreateSpriteSheet(outputFile, inputFiles, install=False):
    
    for ext in ("-ipad", "-ipadhd"):
        imgproduct = "exported/%s%s.png" % (outputFile, ext)
        plistproduct = "exported/%s%s.plist" % (outputFile, ext)
        if install:
            products.append(imgproduct)
            products.append(plistproduct)

        cmd = "/usr/local/bin/TexturePacker"
        cmd += " --sheet " + imgproduct
        cmd += " --data " + plistproduct
        cmd += " --format cocos2d"
        cmd += " --algorithm Basic"
        cmd += " --basic-sort-by best"
        cmd += " --basic-order ascending"
        if ext == "-ipadhd":
            cmd += " --max-width 4096 --max-height 4096"
        else:
            cmd += " --max-width 2048 --max-height 2048"
        cmd += " --border-padding 2"
        cmd += " --shape-padding 10"
        cmd += " --enable-rotation"
        cmd += " --opt RGBA8888"
        cmd += " --no-trim"
        cmd += " --quiet"

        for img in inputFiles:
            tmpFile = "/tmp/%s.png" % (img,)
            exportedFile = "exported/%s%s.png" % (img, ext)
            subprocess.call("cp %s %s" % (exportedFile, tmpFile), shell=True)
            cmd += " " + tmpFile

        print "Creating spritesheet %s%s" % (outputFile,ext)
        if debug:
            print cmd

        subprocess.call(cmd, stdout=file("/dev/null"), stderr=subprocess.STDOUT, shell=True)
        subprocess.call(cmd, shell=True)


def ExportAnimationFrames(inputFile, outputFile, y1, y2, xcoords):
    i = 1
    frames = []
    for xcoord in xcoords:
        outputFileName = outputFile+"_{0}".format(i)
        CropImageAdj(inputFile, outputFileName, xcoord[0], y1, xcoord[1], y2-y1, False)
        frames.append(outputFileName)
        i += 1

    return frames




