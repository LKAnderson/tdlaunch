            products.append(product)

        cmd = [inkScape]
        cmd += [inputFile]
        cmd += ["--without-gui"]
        cmd += ["--export-png=" + product]
        cmd += ["--export-area=%d:%d:%d:%d" % (x1,y1,x2,y2)]
        cmd += ["--export-width=" + str(w)]
